{
  "name": "transmi-vue",
  "version": "0.13.2",
  "private": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "test:unit": "vitest run",
    "lint": "eslint --ext .js,.vue src tests"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^1.2.2",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.11",
    "vitest": "^5.0.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
